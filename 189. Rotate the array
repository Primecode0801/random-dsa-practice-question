-------------------------------------------------------better than brootforce approch-------------------------------------------------------------------

time: O(n)
space:O(n)
uses extra space 

class Solution {
    public void rotate(int[] nums, int k) {

        int n = nums.length;
        int[] temp = new int[n];

        for(int i = 0; i < n; i++) {
            temp[(i + k) % n] = nums[i];
        }

        for(int i = 0; i < n; i++) {
            nums[i] = temp[i];
        }
    }
}
